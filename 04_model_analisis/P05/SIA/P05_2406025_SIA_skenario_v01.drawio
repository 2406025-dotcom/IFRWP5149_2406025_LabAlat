            <mxRectangle height="100" width="290" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="DPJrqh6HSXS6alUaWbav-14" parent="DPJrqh6HSXS6alUaWbav-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;align=center;" value="&#xa;Use case selesai jika KHS semester yang dipilih ditampilkan; jika nilai belum dipublikasikan atau tidak ada data akademik, use case selesai dengan pesan tersebut tanpa menampilkan nilai.&#xa;&#xa;" vertex="1" visible="0">
          <mxGeometry height="100" width="315" x="290" as="geometry">
